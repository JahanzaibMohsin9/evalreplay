{
  "name": "@evalreplay/core",
  "version": "0.1.0",
  "description": "evalreplay trace format, test cases, assertions and runner.",
  "keywords": [
    "ai",
    "agents",
    "llm",
    "evals",
    "testing",
    "traces",
    "ci"
  ],
  "homepage": "https://github.com/JahanzaibMohsin9/evalreplay#readme",
  "bugs": {
    "url": "https://github.com/JahanzaibMohsin9/evalreplay/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JahanzaibMohsin9/evalreplay.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "author": "Jahanzeb Mohsin",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
