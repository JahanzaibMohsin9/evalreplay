{
  "name": "@evalreplay/core",
  "version": "0.0.0",
  "description": "evalreplay trace format, test cases, assertions and runner.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./trace.schema.json": "./schema/trace.schema.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jiti": "2.7.0",
    "tinyglobby": "0.2.17",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
