{
  "name": "@evalreplay/recorder-anthropic",
  "version": "0.1.0",
  "description": "Records every Anthropic SDK call an agent makes into its evalreplay trace, priced at Claude list prices.",
  "keywords": [
    "ai",
    "agents",
    "llm",
    "evals",
    "anthropic",
    "claude",
    "tracing"
  ],
  "homepage": "https://github.com/JahanzaibMohsin9/evalreplay#readme",
  "bugs": {
    "url": "https://github.com/JahanzaibMohsin9/evalreplay/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JahanzaibMohsin9/evalreplay.git",
    "directory": "packages/recorder-anthropic"
  },
  "license": "MIT",
  "author": "Jahanzeb Mohsin",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
